import React, { useEffect, useMemo, useState } from "react";
import { useParams, Link } from "react-router-dom";

/**
 * INITIAL_DATA
 * Dvě ukázkové položky (id "1" a "2") — podle zadání.
 * Pokud chceš změnit obsah testovacích seznamů, uprav tady.
 */
const INITIAL_DATA = [
  {
    id: "1",
    name: "Grocery List",
    owner: "you@example.com",
    archived: false,
    members: [
      { id: "m1", name: "You", initials: "Y" },
      { id: "m2", name: "Sofia", initials: "S" },
    ],
    items: [
      { id: "i1", text: "Milk", done: false },
      { id: "i2", text: "Apples", done: true },
      { id: "i3", text: "Bread", done: false },
    ],
  },
  {
    id: "2",
    name: "Party Supplies",
    owner: "david@example.com",
    archived: false,
    members: [
      { id: "m1", name: "David", initials: "D" },
      { id: "m3", name: "Marta", initials: "M" },
    ],
    items: [
      { id: "p1", text: "Plates", done: false },
      { id: "p2", text: "Cups", done: false },
    ],
  },
];

const STORAGE_KEY = "bfs_shoppinglists_v1";

function loadAllData() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) {
      // First time: seed from INITIAL_DATA
      localStorage.setItem(STORAGE_KEY, JSON.stringify(INITIAL_DATA));
      return INITIAL_DATA;
    }
    return JSON.parse(raw);
  } catch (e) {
    console.error("Failed to load localStorage data", e);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(INITIAL_DATA));
    return INITIAL_DATA;
  }
}

function saveAllData(data) {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  } catch (e) {
    console.error("Failed to save to localStorage", e);
  }
}

export default function ShoppingListDetailRoute() {
  const { id } = useParams();
  const [allLists, setAllLists] = useState(() => loadAllData());
  const list = useMemo(() => allLists.find((l) => l.id === id), [allLists, id]);

  // UI state
  const [newItemText, setNewItemText] = useState("");
  const [filter, setFilter] = useState("all"); // all | active | done
  const [editingTitle, setEditingTitle] = useState(false);
  const [titleDraft, setTitleDraft] = useState(list ? list.name : "");
  const [ownerEmail] = useState(list ? list.owner : "you@example.com");

  // When `id` changes (navigace), update titleDraft
  useEffect(() => {
    setTitleDraft(list ? list.name : "");
  }, [list, id]);

  // Helper: update list in allLists and persist
  function updateList(mutator) {
    setAllLists((prev) => {
      const copy = prev.map((l) => (l.id === id ? mutator({ ...l }) : l));
      saveAllData(copy);
      return copy;
    });
  }

  // Add item
  function handleAdd() {
    const text = (newItemText || "").trim();
    if (!text) return;
    const newItem = { id: "it-" + Date.now(), text, done: false };
    updateList((l) => {
      l.items = [...l.items, newItem];
      return l;
    });
    setNewItemText("");
  }

  function handleKeyDownAdd(e) {
    if (e.key === "Enter") handleAdd();
  }

  function toggleItem(itemId) {
    updateList((l) => {
      l.items = l.items.map((it) => (it.id === itemId ? { ...it, done: !it.done } : it));
      return l;
    });
  }

  function removeItem(itemId) {
    if (!confirm("Opravdu smazat položku?")) return;
    updateList((l) => {
      l.items = l.items.filter((it) => it.id !== itemId);
      return l;
    });
  }

  function editItemText(itemId) {
    const it = list.items.find((it) => it.id === itemId);
    const newText = prompt("Upravit položku:", it.text);
    if (newText == null) return;
    const trimmed = newText.trim();
    if (!trimmed) return;
    updateList((l) => {
      l.items = l.items.map((x) => (x.id === itemId ? { ...x, text: trimmed } : x));
      return l;
    });
  }

  // Title editing
  function saveTitle() {
    const trimmed = (titleDraft || "").trim();
    if (!trimmed) return;
    updateList((l) => {
      l.name = trimmed;
      return l;
    });
    setEditingTitle(false);
  }

  // Members
  function removeMember(memberId) {
    if (!confirm("Opravdu odstranit člena?")) return;
    updateList((l) => {
      l.members = l.members.filter((m) => m.id !== memberId);
      return l;
    });
  }

  // Archive toggle
  function toggleArchive() {
    updateList((l) => {
      l.archived = !l.archived;
      return l;
    });
  }

  // Filtered items
  const filteredItems = useMemo(() => {
    if (!list) return [];
    if (filter === "active") return list.items.filter((it) => !it.done);
    if (filter === "done") return list.items.filter((it) => it.done);
    return list.items;
  }, [list, filter]);

  // Defensive: if list not found, show helpful message
  if (!list) {
    return (
      <div className="min-h-screen bg-gray-100 py-10">
        <div className="max-w-md mx-auto">
          <div className="bg-white rounded-2xl shadow-lg p-6 text-center">
            <h2 className="text-lg font-semibold mb-2">Seznam nenalezen</h2>
            <p className="text-sm text-gray-500 mb-4">Nepodařilo se najít seznam s id = {id}</p>
            <Link to="/shoppingLists" className="text-indigo-600">
              Zpět na přehled
            </Link>
          </div>
        </div>
      </div>
    );
  }

  // UI rendering (kartová mobilní podoba)
  return (
    <div className="min-h-screen bg-gray-100 py-8">
      <div className="max-w-md mx-auto">
        <div className="bg-white rounded-2xl shadow-lg overflow-hidden">
          {/* Header */}
          <div className="p-5 border-b">
            <div className="flex items-center gap-4">
              <div className="w-12 h-12 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold text-lg">
                {list.name?.charAt(0) || "G"}
              </div>

              <div className="flex-1">
                {!editingTitle ? (
                  <>
                    <div className="flex items-center gap-2">
                      <h1 className="text-lg font-semibold">{list.name}</h1>
                      {list.archived && (
                        <span className="text-xs text-gray-500 px-2 py-0.5 rounded-full border">Archived</span>
                      )}
                    </div>
                    <div className="text-xs text-gray-500">Owner · {list.owner}</div>
                  </>
                ) : (
                  <div className="flex gap-2">
                    <input
                      value={titleDraft}
                      onChange={(e) => setTitleDraft(e.target.value)}
                      className="flex-1 rounded-md border border-gray-200 px-3 py-1"
                    />
                    <button onClick={saveTitle} className="px-3 py-1 bg-indigo-600 text-white rounded-md">
                      Save
                    </button>
                  </div>
                )}
              </div>

              <div className="flex gap-2">
                {!editingTitle ? (
                  <button
                    onClick={() => setEditingTitle(true)}
                    className="p-2 rounded-md hover:bg-gray-100"
                    title="Edit"
                  >
                    ✎
                  </button>
                ) : (
                  <button onClick={() => setEditingTitle(false)} className="p-2 rounded-md hover:bg-gray-100">
                    ✕
                  </button>
                )}
              </div>
            </div>
          </div>

          {/* Input */}
          <div className="p-4">
            <div className="flex gap-3">
              <input
                value={newItemText}
                onChange={(e) => setNewItemText(e.target.value)}
                onKeyDown={handleKeyDownAdd}
                placeholder="Add item"
                className="flex-1 rounded-lg border border-gray-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200"
              />
              <button onClick={handleAdd} className="bg-indigo-600 text-white px-4 py-2 rounded-lg shadow">
                Add
              </button>
            </div>

            {/* Filters */}
            <div className="mt-3 flex gap-2 items-center text-sm">
              <div className="flex items-center gap-2">
                <button
                  onClick={() => setFilter("all")}
                  className={`px-3 py-1 rounded-full text-xs ${filter === "all" ? "bg-indigo-600 text-white" : "bg-gray-100"}`}
                >
                  All
                </button>
                <button
                  onClick={() => setFilter("active")}
                  className={`px-3 py-1 rounded-full text-xs ${filter === "active" ? "bg-indigo-600 text-white" : "bg-gray-100"}`}
                >
                  Active
                </button>
                <button
                  onClick={() => setFilter("done")}
                  className={`px-3 py-1 rounded-full text-xs ${filter === "done" ? "bg-indigo-600 text-white" : "bg-gray-100"}`}
                >
                  Done
                </button>
              </div>

              <div className="ml-auto text-sm text-gray-500">{list.items.length} items</div>
            </div>
          </div>

          {/* Items */}
          <div>
            {filteredItems.length === 0 ? (
              <div className="p-4 text-gray-500">No items match the filter.</div>
            ) : (
              <ul>
                {filteredItems.map((it) => (
                  <li key={it.id} className="flex items-center gap-3 px-4 py-3 hover:bg-gray-50">
                    <label className="flex items-center gap-3">
                      <input
                        type="checkbox"
                        checked={!!it.done}
                        onChange={() => toggleItem(it.id)}
                        className="w-5 h-5 rounded-full border-gray-300 text-indigo-600"
                      />
                    </label>

                    <div className="flex-1">
                      <div className={`${it.done ? "line-through text-gray-400" : "text-gray-800"} font-medium`}>
                        {it.text}
                      </div>
                    </div>

                    <div className="flex items-center gap-2">
                      <button onClick={() => editItemText(it.id)} className="p-2 hover:bg-gray-100 rounded-md">
                        ✎
                      </button>
                      <button onClick={() => removeItem(it.id)} className="p-2 hover:bg-gray-100 rounded-md text-red-500">
                        🗑
                      </button>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>

          {/* Footer */}
          <div className="p-4 border-t flex items-center justify-between gap-3">
            <div className="flex items-center gap-2 overflow-hidden">
              {list.members.map((m) => (
                <div key={m.id} className="flex items-center gap-2 bg-gray-100 px-2 py-1 rounded-full text-sm">
                  <div className="w-6 h-6 rounded-full bg-indigo-400 text-white flex items-center justify-center text-xs">
                    {m.initials}
                  </div>
                  <div className="text-xs text-gray-700">{m.name}</div>
                  {/* if current user is owner, show remove */}
                  {list.owner === ownerEmail && (
                    <button
                      onClick={() => removeMember(m.id)}
                      className="ml-2 text-xs text-red-500 px-1 hover:bg-gray-100 rounded"
                      title="Remove member"
                    >
                      ✕
                    </button>
                  )}
                </div>
              ))}
            </div>

            <div className="flex items-center gap-2">
              <button onClick={toggleArchive} className="px-3 py-1 rounded-lg border border-gray-200 text-sm">
                {list.archived ? "Unarchive" : "Archive"}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
